# Copy this file to .env and fill in real values, or export these as real
# environment variables. NEVER commit a real .env file (it's in .gitignore).
#
# See RESEARCH.md §6.4 before this ever touches live capital: in production
# (Managed Agents), the exchange/wallet credential belongs in a vault
# `environment_variable` credential — substituted at egress, never visible
# to the model — not as a plain environment variable an agent's own shell
# access could read. The .env pattern below is for LOCAL DEVELOPMENT and
# PAPER TRADING only.

# Required to run any agent (crypto_desk.cli backtest / a live tick).
ANTHROPIC_API_KEY=sk-ant-...

# Not required for the default free-tier data sources in crypto_desk/data/
# (CoinGecko's public market_chart/range endpoint, cryptocurrency.cv's free
# news API — see RESEARCH.md §5.3). Leave unset unless you've swapped in a
# provider that needs one.
# COINGECKO_API_KEY=
# TWELVE_DATA_API_KEY=

# NOT WIRED UP IN THIS CODEBASE YET. Execution is paper-only
# (crypto_desk.portfolio.ledger.PaperLedger) until RESEARCH.md §9.4 Phase 2's
# custody bar is cleared. Do not put a real exchange API key or a wallet
# private key here or anywhere else in this repo's plain files.
# EXCHANGE_API_KEY=
# EXCHANGE_API_SECRET=
